  {
    "name": "age_years",
    "business_definition": "Applicant age in whole years at application date",
    "source_system": "application",
    "owner": "credit_risk",
    "formula": "floor((application_date - date_of_birth) / 365.25)",
    "observation_window": "point-in-time",
    "data_type": "numeric",
    "min_value": 18,
    "max_value": 100,
    "missing_treatment": "block",
